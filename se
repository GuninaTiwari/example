from bs4 import BeautifulSoup, NavigableString, Tag
import re
import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import Border, Side, Font

# HTML file 
html_file = "AR.html"

# Read HTML
with open(html_file, "r" ) as f:
    soup = BeautifulSoup(f, "html.parser")

# Excel writer
output_file = "AR.xlsx"
writer = pd.ExcelWriter(output_file, engine="openpyxl")

# Find all "Table:" sections
for tag in soup.find_all(text=lambda t: "Table:" in t):
    table_name = tag.split("Table:")[-1].strip()

    # Find the "Columns" section (the boundary where PK scanning should stop)
    columns_heading = tag.find_next(string=lambda t: "Columns" in t)
    table_tag = columns_heading.find_next("table") if columns_heading else None

    # --- Primary Key extraction: scan only between 'tag' and 'columns_heading' ---
    pk_list = []
    if columns_heading:
        scanning_for_pk = False
        for elem in tag.next_elements:
            if elem == columns_heading:
                break

            text = ""
            if isinstance(elem, Tag):
                text = elem.get_text(separator=" ", strip=True)
            elif isinstance(elem, NavigableString):
                text = str(elem).strip()
            else:
                continue

            if not text:
                continue

            if re.search(r"Primary\s*Key", text, flags=re.IGNORECASE):
                if re.search(r"_UK1\s*$", text, flags=re.IGNORECASE):
                    scanning_for_pk = False
                    continue
                scanning_for_pk = True
                continue

            if scanning_for_pk:
                if isinstance(elem, Tag) and elem.name in ["h1","h2","h3","h4","h5","h6"]:
                    scanning_for_pk = False
                    continue

                if isinstance(elem, Tag) and elem.name in ["ol","ul"]:
                    for li in elem.find_all("li"):
                        li_text = li.get_text(separator=" ", strip=True)
                        li_text = re.sub(r"^\s*\d+\.\s*", "", li_text)
                        if li_text:
                            pk_list.append(li_text.strip())
                    scanning_for_pk = False
                    break

                if isinstance(elem, NavigableString):
                    s = str(elem).strip()
                    m = re.match(r"^\s*\d+\.\s*(.+)", s)
                    if m:
                        val = m.group(1).strip()
                        if val:
                            pk_list.append(val)

    pk_list = [p.strip().upper() for p in pk_list if p and p.strip()]

    # ✅ Foreign Key Extraction logic added here
    fk_list = []
    fk_tables = {}
    fk_heading = tag.find_next(string=lambda t: "Foreign Keys from this table" in t)

    if fk_heading:
        fk_table_tag = fk_heading.find_next("table")
        if fk_table_tag:
            try:
                fk_df = pd.read_html(str(fk_table_tag), flavor="lxml")[0]
            except:
                fk_df = pd.read_html(str(fk_table_tag), flavor="html5lib")[0]

            fk_df.columns = [c.strip().lower() for c in fk_df.columns]

            if "foreign key column" in fk_df.columns and "foreign table" in fk_df.columns:
                for col, tbl in zip(fk_df["foreign key column"], fk_df["foreign table"]):
                    if "." in col:
                        cname = col.split(".")[-1].strip().upper()
                    else:
                        cname = col.strip().upper()
                    fk_list.append(cname)
                    fk_tables[cname] = tbl.strip()

    # Now process the Columns table as before
    if table_tag:
        try:
            df = pd.read_html(str(table_tag), flavor="lxml")[0]
        except:
            df = pd.read_html(str(table_tag), flavor="html5lib")[0]

        df.insert(0, "Sequence No.", range(1, len(df) + 1))
        df.insert(1, "Table Name", table_name)

        df["Date Format"] = ""
        df["Primary Key (Yes/No)"] = ""
        df["Foreign Key (Yes/No)"] = ""
        df["Foreign Key Table"] = ""
        df["Pll data (Yes/No)"] = ""

        if "Datatype" in df.columns:
            df.loc[df["Datatype"].astype(str).str.lower().str.contains("date", na=False), "Date Format"] = "DD-MON-YY"
        else:
            for col in df.columns:
                if col.strip().lower() in ["data type","data_type"]:
                    df.loc[df[col].astype(str).str.lower().str.contains("date", na=False), "Date Format"] = "DD-MON-YY"
                    break

        name_col = None
        for col in df.columns:
            if col.strip().lower() == "name":
                name_col = col
                break

        if name_col:
            if pk_list:
                pk_set = set([p.upper() for p in pk_list])
                df["Primary Key (Yes/No)"] = df[name_col].astype(str).apply(
                    lambda x: "Yes" if str(x).strip().upper() in pk_set else "No"
                )
            else:
                df["Primary Key (Yes/No)"] = "No"

            # ✅ Foreign Key Apply (Matching Logic)
            df["Foreign Key (Yes/No)"] = df[name_col].astype(str).apply(
                lambda x: "Yes" if str(x).strip().upper() in fk_list else "No"
            )
            df["Foreign Key Table"] = df[name_col].astype(str).apply(
                lambda x: fk_tables.get(str(x).strip().upper(), "")
            )

        safe_name = table_name[:50]
        df.to_excel(writer, sheet_name=safe_name, index=False)

writer.close()

wb = load_workbook(output_file)
thin_border = Border(left=Side(style="thin"), right=Side(style="thin"),
                     top=Side(style="thin"), bottom=Side(style="thin"))

for sheet in wb.sheetnames:
    ws = wb[sheet]
    for row_idx, row in enumerate(ws.iter_rows()):
        for cell in row:
            cell.border = thin_border
            if row_idx == 0:
                cell.font = Font(bold=True)

    for col in ws.columns:
        max_length = 0
        col_letter = col[0].column_letter
        for cell in col:
            try:
                if cell.value:
                    max_length = max(max_length, len(str(cell.value)))
            except:
                pass
        ws.column_dimensions[col_letter].width = max_length + 4

wb.save(output_file)

print("✅ Final Excel ready:", output_file)
wb = load_workbook(output_file)
print(f"📊 The Excel file has {len(wb.sheetnames)} sheets.")
