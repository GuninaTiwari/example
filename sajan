from bs4 import BeautifulSoup
import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import Border, Side, Font

# HTML file
html_file = "AR.html"

# Read HTML
with open(html_file, "r", encoding="utf-8") as f:
    soup = BeautifulSoup(f, "html.parser")

# Excel writer
output_file = "AR_sheet.xlsx"
writer = pd.ExcelWriter(output_file, engine="openpyxl")

# Find all "Table:" sections
for tag in soup.find_all(string=lambda t: "Table:" in t):
    table_name = tag.split("Table:")[-1].strip()

    # Find "Columns" heading
    columns_heading = tag.find_next(string=lambda t: "Columns" in t)
    table_tag = columns_heading.find_next("table") if columns_heading else None

    if not table_tag:
        continue

    try:
        df = pd.read_html(str(table_tag), flavor="lxml")[0]
    except:
        df = pd.read_html(str(table_tag), flavor="html5lib")[0]

    # Add required columns
    df.insert(0, "Sequence No.", range(1, len(df) + 1))
    df.insert(1, "Table Name", table_name)
    df["Date Format"] = ""
    df["Primary Key (Yes/No)"] = "No"
    df["Foreign Key (Yes/No)"] = ""
    df["Foreign Key Table"] = ""
    df["Pll data (Yes/No)"] = ""

    # ✅ Date format autofill
    if "Datatype" in df.columns:
        df.loc[df["Datatype"].astype(str).str.contains("date", case=False, na=False),
               "Date Format"] = "DD-MON-YY"

    # ✅ STRICT Primary Key Detection (only inside same table)
    pk_heading = columns_heading.find_next(string=lambda t: "Primary Key" in t)

    if pk_heading:
        pk_text = pk_heading.strip()

        # ❌ Skip UK1 headings
        if not pk_text.endswith("_UK1"):
            pk_list = []
            list_tag = pk_heading.find_next(["ol", "ul"])

            if list_tag:
                for li in list_tag.find_all("li"):
                    li_text = li.text.strip()

                    # Clean PK value formats
                    if "." in li_text:
                        li_text = li_text.split(".", 1)[1].strip()
                    if "-" in li_text:
                        li_text = li_text.split("-", 1)[0].strip()

                    pk_list.append(li_text.upper())

            # ✅ Apply only if pk list exists & Name column exists
            if pk_list and "Name" in df.columns:
                df["Primary Key (Yes/No)"] = (
                    df["Name"]
                    .astype(str)
                    .str.strip()
                    .str.upper()
                    .isin(pk_list)
                    .map({True: "Yes", False: "No"})
                )

    # ✅ Safe sheet name
    safe_name = table_name[:50]
    df.to_excel(writer, sheet_name=safe_name, index=False)

writer.close()

# ✅ Formatting
wb = load_workbook(output_file)
thin_border = Border(left=Side(style="thin"),
                     right=Side(style="thin"),
                     top=Side(style="thin"),
                     bottom=Side(style="thin"))

for sheet in wb.sheetnames:
    ws = wb[sheet]

    for i, row in enumerate(ws.iter_rows()):
        for cell in row:
            cell.border = thin_border
            if i == 0:
                cell.font = Font(bold=True)

    for col in ws.columns:
        max_len = max(len(str(c.value)) if c.value else 0 for c in col)
        ws.column_dimensions[col[0].column_letter].width = max_len + 2

wb.save(output_file)

print("✅ Final Excel successfully created:", output_file)
print(f"📊 Total Sheets: {len(wb.sheetnames)}")
