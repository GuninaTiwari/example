from bs4 import BeautifulSoup, NavigableString, Tag
import re
import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import Border, Side, Font

# HTML file 
html_file = "AR.html"

# Read HTML
with open(html_file, "r" ) as f:
    soup = BeautifulSoup(f, "html.parser")

# Excel writer
output_file = "AR.xlsx"
writer = pd.ExcelWriter(output_file, engine="openpyxl")

# Find all "Table:" sections
for tag in soup.find_all(text=lambda t: "Table:" in t):
    table_name = tag.split("Table:")[-1].strip()

    columns_heading = tag.find_next(string=lambda t: "Columns" in t)
    table_tag = columns_heading.find_next("table") if columns_heading else None

    # ----- PRIMARY KEY EXTRACTION (same as your logic) -----
    pk_list = []
    if columns_heading:
        scanning_for_pk = False
        for elem in tag.next_elements:
            if elem == columns_heading:
                break
            text = ""
            if isinstance(elem, Tag):
                text = elem.get_text(separator=" ", strip=True)
            elif isinstance(elem, NavigableString):
                text = str(elem).strip()
            else:
                continue

            if not text:
                continue

            if re.search(r"Primary\s*Key", text, flags=re.IGNORECASE):
                if re.search(r"_UK1\s*$", text, flags=re.IGNORECASE):
                    scanning_for_pk = False
                    continue
                scanning_for_pk = True
                continue

            if scanning_for_pk:
                if isinstance(elem, Tag) and elem.name in ["h1","h2","h3","h4","h5","h6"]:
                    scanning_for_pk = False
                    continue
                if isinstance(elem, Tag) and elem.name in ["ol","ul"]:
                    for li in elem.find_all("li"):
                        li_text = re.sub(r"^\s*\d+\.\s*", "", li.get_text(strip=True))
                        if li_text:
                            pk_list.append(li_text)
                    scanning_for_pk = False
                    break
                if isinstance(elem, NavigableString):
                    m = re.match(r"^\s*\d+\.\s*(.+)", str(elem))
                    if m:
                        pk_list.append(m.group(1).strip())

    pk_list = [p.strip().upper() for p in pk_list if p.strip()]

    # ✅ FOREIGN KEY EXTRACTION — Fully Corrected ✅
    fk_start = tag.find_next(string=lambda t: "Foreign Keys from this table" in t if isinstance(t, str) else False)
    foreign_key_columns = set()
    foreign_key_tables = {}

    if fk_start:
        for elem in fk_start.next_elements:
            line = ""
            if isinstance(elem, NavigableString):
                line = elem.strip()
            elif isinstance(elem, Tag):
                line = elem.get_text(strip=True)
            else:
                continue

            if not line:
                continue

            if line.lower().startswith("next table:"):
                break
            if "Foreign Keys to this table" in line:
                break

            if "." in line:
                table, col = line.split(".", 1)
                table = table.strip()
                col = col.strip().upper()
                foreign_key_columns.add(col)
                foreign_key_tables[col] = table

    # ----- COLUMN TABLE PROCESSING -----
    if table_tag:
        df = pd.read_html(str(table_tag))[0]
        df.insert(0, "Sequence No.", range(1, len(df) + 1))
        df.insert(1, "Table Name", table_name)

        df["Date Format"] = ""
        df["Primary Key (Yes/No)"] = ""
        df["Foreign Key (Yes/No)"] = ""
        df["Foreign Key Table"] = ""
        df["Pll data (Yes/No)"] = ""

        # Date format rule
        for col in df.columns:
            if col.strip().lower() in ["datatype","data type","data_type"]:
                df.loc[
                    df[col].astype(str).str.lower().str.contains("date", na=False),
                    "Date Format"
                ] = "DD-MON-YY"
                break

        name_col = None
        for col in df.columns:
            if col.strip().lower() == "name":
                name_col = col
                break

        if name_col:
            df["Primary Key (Yes/No)"] = df[name_col].astype(str).str.upper()\
                .apply(lambda x: "Yes" if x in pk_list else "No")

            df["Foreign Key (Yes/No)"] = df[name_col].astype(str).str.upper()\
                .apply(lambda x: "Yes" if x in foreign_key_columns else "No")

            df["Foreign Key Table"] = df[name_col].astype(str).str.upper()\
                .apply(lambda x: foreign_key_tables.get(x, ""))

        safe_name = table_name[:50]
        df.to_excel(writer, sheet_name=safe_name, index=False)

# Save and styling
writer.close()
wb = load_workbook(output_file)
thin = Border(left=Side(style="thin"), right=Side(style="thin"),
              top=Side(style="thin"), bottom=Side(style="thin"))

for sheet in wb.sheetnames:
    ws = wb[sheet]
    for r, row in enumerate(ws.iter_rows()):
        for cell in row:
            cell.border = thin
            if r == 0: cell.font = Font(bold=True)

    for col in ws.columns:
        length = max(len(str(c.value)) if c.value else 0 for c in col)
        ws.column_dimensions[col[0].column_letter].width = length + 4

wb.save(output_file)
wb = load_workbook(output_file)
print("✅ Final Excel ready:", output_file)
print(f"📊 Sheets: {len(wb.sheetnames)}")
